# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — used by /api/import-stocking to bypass RLS
# Found in Settings > API > service_role key. Keep this secret (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox — public token from mapbox.com/account/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Cron auth secret — any random string, must match Vercel cron config
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
